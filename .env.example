# Frontend
VITE_API_URL=http://localhost:5000/api

# Backend
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/gharkhoj
JWT_SECRET=replace-with-a-long-random-secret

# Resend (required for owner email verification and forgot password)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="GharKhoj <no-reply@gharkhoj.nischal-niraula.com.np>"

# Optional: Cloudinary for production room image storage.
# Without these, local development stores images under server/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin seeding (run: npm run seed:admin)
ADMIN_NAME=GharKhoj Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisStrongPassword
